      "id": "concept:distribution-as-moat",
      "label": "Distribution as moat",
      "kind": "concept",
      "meta": {
        "kind": "principle",
        "one_line": "In a world where capability gets commoditized, the durable advantage is whether you can reach people at all.",
        "aliases": []
      }
    },
