      "label": "AI-first",
      "kind": "concept",
      "meta": {
        "kind": "principle",
        "one_line": "Hire and operate as if AI is the default tool, not the optional one. Companies will shed staff and rehire AI-first.",
        "aliases": []
      }
    },
